; The IV increments carry no wrap flags. A dominating guard on the bound
; keeps the IV from wrapping before the exit is taken.

define void @slt_guarded_rhs(i32 %n) {
; CHECK-LABEL: 'slt_guarded_rhs'
; CHECK-NEXT:  Determining loop execution counts for: @slt_guarded_rhs
; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 + (4 smax %n))<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 536870910
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 + (4 smax %n))<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %guard = icmp slt i32 %n, 1000
  br i1 %guard, label %loop, label %exit

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %iv.next = add i32 %iv, 4
  %cmp = icmp slt i32 %iv.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

