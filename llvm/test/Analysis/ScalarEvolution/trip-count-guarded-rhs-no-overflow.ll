; Multiple exits, as in a bounds-checked loop.
define void @slt_guarded_rhs_multiple_exits(i64 %n, i64 %len) {
; CHECK-LABEL: 'slt_guarded_rhs_multiple_exits'
; CHECK-NEXT:  Determining loop execution counts for: @slt_guarded_rhs_multiple_exits
; CHECK-NEXT:  Loop %loop: <multiple exits> Unpredictable backedge-taken count.
; CHECK-NEXT:    exit count for loop: ***COULDNOTCOMPUTE***
; CHECK-NEXT:    exit count for latch: ((-1 + (4 smax %n))<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 2305843009213693950
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 + (4 smax %n))<nsw> /u 4)
; CHECK-NEXT:    symbolic max exit count for loop: ***COULDNOTCOMPUTE***
; CHECK-NEXT:    symbolic max exit count for latch: ((-1 + (4 smax %n))<nsw> /u 4)
;
entry:
  %guard = icmp slt i64 %n, 1000
  br i1 %guard, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %iv.next = add i64 %iv, 4
  %oob = icmp ult i64 %len, %iv.next
  br i1 %oob, label %exit, label %latch

latch:
  %cmp = icmp slt i64 %iv.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}
