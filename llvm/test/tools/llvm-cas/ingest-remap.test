REQUIRES: symlinks

RUN: rm -rf %t && mkdir -p %t

RUN: llvm-cas ingest --cas %t/cas --prefix-map %S/Inputs=/^input %S/Inputs > %t/cas.id
RUN: llvm-cas ls-tree-recursive --cas %t/cas @%t/cas.id | FileCheck %s

CHECK: syml
CHECK-SAME: /^input/broken_symlink -> missing
CHECK: file
CHECK-SAME: /^input/directory/file
CHECK: syml
CHECK-SAME: /^input/file -> directory/file
CHECK: file
CHECK-SAME: /^input/oneline
CHECK: file
CHECK-SAME: /^input/oneline-nonewline
CHECK: syml
CHECK-SAME: /^input/self -> .
CHECK: syml
CHECK-SAME: /^input/sym_dir -> directory
