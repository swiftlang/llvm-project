# Verify that dsymutil collects .cas-config files in parent paths of
# each debug map object and aggregates their contents into
# Contents/Resources/CASConfigs.json inside the output dSYM bundle.
#
# The object paths are relative to the working directory, so that the search
# stays inside the test directory and doesn't find .cas-config files in parent
# directories of the build directory.

# RUN: rm -rf %t.dir && mkdir -p %t.dir/root/sub
# RUN: cp %p/../Inputs/DWARF5/1.o %t.dir/root/sub/1.o
# RUN: echo '{"CASPath": "test-cas1"}' > %t.dir/root/sub/.cas-config
# RUN: echo '{"CASPath": "test-cas2"}' > %t.dir/root/.cas-config
# RUN: cd %t.dir

# RUN: dsymutil --linker classic -y %p/dummy-debug-map-arm64.map \
# RUN:   -oso-prepend-path=root/sub -o %t.dir/classic.dSYM
# RUN: cat %t.dir/classic.dSYM/Contents/Resources/CASConfigs.json | FileCheck %s

# RUN: dsymutil --linker parallel -y %p/dummy-debug-map-arm64.map \
# RUN:   -oso-prepend-path=root/sub -o %t.dir/parallel.dSYM
# RUN: cat %t.dir/parallel.dSYM/Contents/Resources/CASConfigs.json | FileCheck %s

# CHECK:      [
# CHECK-NEXT:   {"CASPath": "test-cas1"},
# CHECK-NEXT:   {"CASPath": "test-cas2"}
# CHECK-NEXT: ]

# Without a .cas-config file present, no CASConfigs.json should be produced.

# RUN: rm -rf %t.empty && mkdir -p %t.empty/sub
# RUN: cp %p/../Inputs/DWARF5/1.o %t.empty/sub/1.o
# RUN: cd %t.empty

# RUN: dsymutil --linker classic -y %p/dummy-debug-map-arm64.map \
# RUN:   -oso-prepend-path=sub -o %t.empty/classic.dSYM
# RUN: not ls %t.empty/classic.dSYM/Contents/Resources/CASConfigs.json

# RUN: dsymutil --linker parallel -y %p/dummy-debug-map-arm64.map \
# RUN:   -oso-prepend-path=sub -o %t.empty/parallel.dSYM
# RUN: not ls %t.empty/parallel.dSYM/Contents/Resources/CASConfigs.json
