// https://github.com/swiftlang/llvm-project/issues/9539
// XFAIL: system-windows
// Test that we can define and use zero-sized struct in the repl.
// REQUIRES: swift

// RUN: %lldb --repl < %s | FileCheck %s

struct Patatino {}
let tinky = Patatino()
// CHECK: tinky: Patatino = {}

tinky
// CHECK: $R0: Patatino = {}
