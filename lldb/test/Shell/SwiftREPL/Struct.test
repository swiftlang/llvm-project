// https://github.com/swiftlang/llvm-project/issues/9539
// XFAIL: system-windows
// Test that we can define and use structs in the REPL.
// REQUIRES: swift

// RUN: %lldb --repl < %s | FileCheck %s

struct foo {
  var bar : Int
  var baaz : Int
}

foo(bar: 2, baaz: 3)
CHECK: $R0: foo = {
CHECK-NEXT:   bar = 2
CHECK-NEXT:   baaz = 3
CHECK-NEXT: }
